<local:AdvanceWindow x:Class="CoinCollection.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoinCollection"
        mc:Ignorable="d"
        Title="CustomMessageBoxWindow" Height="auto" Width="250" WindowStyle="None" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" BorderThickness="1" ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="20" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MessageBoxStyle" TargetType="Button">
            <Setter Property="Background" Value="#DFDFDF"/>
            <!-- Light gray -->
            <Setter Property="BorderBrush" Value="#808080"/>
            <!-- Standard Win98 border -->
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <!-- No modern drop shadow -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Top-left highlight -->
                                <Rectangle x:Name="TopLeft_Highlight" Fill="#FFFFFF" Height="1" VerticalAlignment="Top" Margin="0,0,0,0.5"/>
                                <Rectangle x:Name="Left_Highlight" Fill="#FFFFFF" Width="1" HorizontalAlignment="Left" Margin="0,0,0.5,0"/>

                                <!-- Bottom-right shadow -->
                                <Rectangle Fill="#808080" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,0.5"/>
                                <Rectangle Fill="#808080" Width="1" HorizontalAlignment="Right"/>

                                <ContentPresenter x:Name="ButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Pressed Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopLeft_Highlight" Property="Fill" Value="#808080"/>
                                <Setter TargetName="Left_Highlight" Property="Fill" Value="#808080"/>
                            </Trigger>
                            <!-- Disabled Effect -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonText" Property="TextElement.Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" BorderThickness="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.8" Direction="360"/>
        </Border.Effect>
        <Grid>
        <Grid x:Name="Title_Background" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="CadetBlue" Height="20">
            <Label Content="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="9"/>
            <StackPanel Height="20" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="Exit" Click="Close_Click" Width="20" FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>
        <Grid VerticalAlignment="Top" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" x:Name="Main_Background" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Row="1" Grid.Column="0" x:Name="Icon_Image" HorizontalAlignment="Left" Height="25" Margin="10,5,0,0" VerticalAlignment="Top" Width="25"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Description" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Top">
                    This is a test
                </TextBlock>
            </Grid>
            <Grid Grid.Row="1" VerticalAlignment="Bottom" Background="LightGray">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Grid.Row="1" x:Name="Options" Orientation="Horizontal" Height="20" Visibility="Collapsed">
                    <CheckBox x:Name="Extra_Option" Height="20" Width="20"/>
                    <Label x:Name="Extra_Option_Label" Content="Info" Width="auto" Height="25" Margin="0,-5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" x:Name="Button_Parent" Width="auto" Height="25" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</local:AdvanceWindow>
